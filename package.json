{
  "name": "ikkoma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run lib/domain",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/import-study.ts",
    "db:import-study": "tsx scripts/import-study.ts",
    "test:integration": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://localhost:5432/ikkoma_test} vitest run lib/__tests__",
    "test:all": "npm run test && npm run test:integration",
    "mcp": "tsx --tsconfig tsconfig.json mcp/server.ts",
    "mcp:smoke": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://localhost:5432/ikkoma_test} tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
